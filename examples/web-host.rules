# Generated by iptables-save (fictional example host)
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
:ADMIN - [0:0]
:LEGACY - [0:0]
-A INPUT -i lo -j ACCEPT
-A INPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A INPUT -p tcp -m tcp --dport 22 -j ACCEPT
-A INPUT -p tcp -m multiport --dports 80,443 -j ACCEPT
-A INPUT -s 10.0.0.0/8 -p tcp -m tcp --dport 22 -j ACCEPT
-A INPUT -s 192.0.2.0/24 -j ADMIN
-A INPUT -p tcp -m tcp --dport 8080 -m limit --limit 10/second -j ACCEPT
-A INPUT -p tcp -m tcp --dport 3306 -j ACCEPT
-A ADMIN -p tcp -m tcp --dport 9000 -j ACCEPT
-A ADMIN -j RETURN
-A LEGACY -j DROP
COMMIT
